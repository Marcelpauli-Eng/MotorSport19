# Configuración del servidor del taller.
# Copia este fichero a `.env` en el mini-PC y rellena los valores.
#
#   cp .env.taller.example .env

# ---------- Base de datos ----------
POSTGRES_DB=motorsport19
POSTGRES_USER=taller
# Genérala con:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- Aplicación ----------
# Deja solo `docker` para arrancar vacío.
# Pon `docker,demo` la primera vez si quieres ver datos de ejemplo.
SPRING_PROFILES_ACTIVE=docker

# Clave con la que se firman las sesiones. La API no arranca sin ella, y exige
# al menos 32 caracteres.
#
# Genérala con:  openssl rand -base64 48
#
# Si la cambias, todo el mundo tendrá que volver a entrar. No es grave, y es lo
# que hay que hacer si alguna vez sospechas que se ha filtrado.
CLAVE_JWT=

# Puerto por el que entran los equipos del taller: http://IP-DEL-MINIPC
PUERTO_WEB=80

TZ=Europe/Madrid

# ---------- Copias de seguridad ----------
#
# ⚠️ CLAVE_CIFRADO es lo más importante de este fichero.
# Si la pierdes, TODAS las copias quedan ilegibles para siempre. Guárdala en un
# gestor de contraseñas Y apuntada en papel en un sitio seguro fuera del taller.
#
# Genérala con:  openssl rand -base64 32
CLAVE_CIFRADO=

# Hora de la copia diaria (el taller está cerrado).
HORA_COPIA=03
MINUTO_COPIA=30

# Haz una copia nada más arrancar la primera vez, para comprobar que todo va.
# Después ponlo a false.
COPIA_AL_ARRANCAR=true

# Días que se guardan las copias en el propio mini-PC.
DIAS_RETENCION_LOCAL=7

# Destino remoto, con el nombre que le hayas dado en `rclone config`.
# Ejemplos:  copias:motorsport19    ·    b2:mi-bucket/motorsport19
# Si lo dejas vacío, la copia se queda SOLO en el taller: no protege de un
# incendio ni de un robo.
RCLONE_DESTINO=

# ---------- Acceso desde fuera (opcional) ----------
# Token del túnel de Cloudflare. Se obtiene al crear el túnel en
# one.dash.cloudflare.com → Networks → Tunnels.
# Se activa con:  docker compose -f docker-compose.taller.yml --profile tunel up -d
CLOUDFLARE_TUNNEL_TOKEN=
