# Copia este fichero a `.env` y ajusta los valores antes de levantar docker-compose.

# ---------- Base de datos ----------
POSTGRES_DB=motorsport19
POSTGRES_USER=taller
POSTGRES_PASSWORD=cambiame_en_produccion
POSTGRES_PORT=5432

# ---------- API ----------
API_PORT=8080
# Perfiles de Spring. Añade `demo` para cargar los datos de demostración.
SPRING_PROFILES_ACTIVE=docker,demo

# ---------- Frontend ----------
WEB_PORT=4200

# ---------- Zona horaria ----------
TZ=Europe/Madrid
