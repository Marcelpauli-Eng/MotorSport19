# Copia este fichero a `.env` y ajusta los valores antes de levantar docker-compose.

# ---------- Base de datos local (docker-compose.yml) ----------
POSTGRES_DB=motorsport19
POSTGRES_USER=taller
POSTGRES_PASSWORD=cambiame_en_produccion
POSTGRES_PORT=5432

# ---------- Base de datos en Supabase (docker-compose.supabase.yml) ----------
# Usa el POOLER EN MODO SESSION, puerto 5432. Ni la conexion directa (solo IPv6)
# ni el modo transaction (puerto 6543, rompe Flyway) sirven aqui.
# La region y la referencia del proyecto salen del panel de Supabase:
#   Project Settings -> Database -> Connection string -> Session pooler
#SUPABASE_DB_URL=jdbc:postgresql://aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
#SUPABASE_DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
#SUPABASE_DB_PASSWORD=
# Con Supabase, CLAVE_JWT si es obligatoria (docker-compose.supabase.yml la exige).

# ---------- API ----------
API_PORT=8080

# Clave con la que se firman las sesiones. En local puedes dejarla comentada:
# docker-compose.yml trae una de desarrollo. Fuera de local es obligatoria y de
# al menos 32 caracteres; sin ella la API no arranca.
#   openssl rand -base64 48
#CLAVE_JWT=
# Perfiles de Spring. Añade `demo` para cargar los datos de demostración.
SPRING_PROFILES_ACTIVE=docker,demo

# ---------- Frontend ----------
WEB_PORT=4200

# ---------- Cámaras (opcional) ----------
# Solo se levantan con `docker compose --profile camaras up -d`, y hace falta
# haber creado antes `infra/camaras/go2rtc.yaml` con las cámaras del taller.
# Puerto de WebRTC, la vía rápida entre el navegador y las cámaras.
WEBRTC_PORT=8555
# Puerto de la API de cámaras. Solo se abre en el propio equipo (127.0.0.1),
# nunca a la red: quien quiera ver las cámaras tiene que entrar en el programa.
CAMARAS_PORT=1984

# ---------- Zona horaria ----------
TZ=Europe/Madrid
